{% if breadcrumbs|length > 0 %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 py-2" data-qa="breadcrumb">
            {% for breadcrumbItem in breadcrumbs %}
                {% if breadcrumbItem.uri is not empty and not loop.last %}
                    <li class="breadcrumb-item">
                        <a href="{{ breadcrumbItem.uri }}" title="{{ breadcrumbItem.title | trans }}">
                            {{ breadcrumbItem.label | trans }}
                        </a>
                    </li>
                {% else %}
                    <li class="breadcrumb-item {{ loop.last ? 'active' }}"{% if loop.last %} aria-current="page"{% endif %}>
                        {{ breadcrumbItem.label | trans }}
                    </li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>
{% endif %}
